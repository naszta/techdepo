# TechDepó local configuration.
#
# Copy to `.env` (git-ignored) and fill in. devenv loads `.env` automatically
# (`dotenv.enable = true`). `xtask dev-vars` writes each worker's `.dev.vars`
# (also git-ignored) with only the keys that worker needs.
#
# Values marked "local default" work as-is with the local stack (`devenv up`;
# docs/local-development.md). The deployed environments (dev, live) are configured in
# GitHub environments or deploy/<env>.env, not here (docs/deploy.md).

# --- App -------------------------------------------------------------------

# Public base URL, used for links in emails (local default: the web worker).
APP_BASE_URL=http://localhost:8787

# --- Cloudflare --------------------------------------------------------------

# Needed for the remote Workers AI binding in local dev (LLM_BACKEND=workers-ai)
# and `xtask eval` on `cloudflare:` models (Workers AI REST API).
CLOUDFLARE_ACCOUNT_ID=
# API token with Workers AI:Read.
CLOUDFLARE_API_TOKEN=

# --- Restate -----------------------------------------------------------------

# Ingress used by the web worker, mail-in worker and xtask.
# Local default: http://localhost:8080
# Restate Cloud: https://<environment>.env.<eu|us>.restate.cloud:8080
RESTATE_INGRESS_URL=http://localhost:8080
# Admin API, used to register deployments.
# Local default: http://localhost:9070
RESTATE_ADMIN_URL=http://localhost:9070
# Restate Cloud API key with ingress access (empty for local).
RESTATE_API_KEY=
# Request identity public key(s) `publickeyv1_...`, comma separated (empty for local: the
# local services worker runs with AUTH_MODE=dev and accepts the unsigned local Restate).
RESTATE_IDENTITY_KEYS=

# --- Auth / Clerk ------------------------------------------------------------

# `dev`: local dev login without Clerk (never deployed). `clerk`: real sign-in with a Clerk
# development instance (web and mail-in workers; docs/local-development.md).
AUTH_MODE=dev

# From the Clerk dashboard → API keys (development instance for local).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Origins allowed in the session token's `azp` claim, comma separated.
CLERK_AUTHORIZED_PARTIES=http://localhost:8787,http://localhost:8080

# --- Email -------------------------------------------------------------------

EMAIL_DOMAIN=techdepo.dev
# Support address local part: support+<org>@EMAIL_DOMAIN
SUPPORT_LOCAL_PART=support
EMAIL_FROM_NAME=TechDepó Support
# Outbound transport for the Restate Email service: `mailpit` (local) or `resend`.
EMAIL_TRANSPORT=mailpit
# Local default: Mailpit HTTP API (UI on http://localhost:8025)
MAILPIT_URL=http://localhost:8025
# Required when EMAIL_TRANSPORT=resend.
RESEND_API_KEY=
# How mail-in authenticates a sender: `dmarc` (production; our MTA's Authentication-Results
# must say dmarc=pass for the From domain, anything else is dropped) or `trust-from` (local
# only, needs AUTH_MODE=dev: wrangler's email trigger adds no Authentication-Results).
# Empty: mail-in's wrangler.toml default (`trust-from` in local dev, `dmarc` in production).
INBOUND_SENDER_AUTH=
# The receiving MTA's authserv-id in Authentication-Results (empty: mx.cloudflare.net).
INBOUND_AUTHSERV_ID=

# --- AI ----------------------------------------------------------------------

# `mock`: deterministic keyword classifier and canned agent replies, so the
# stack runs without a Cloudflare account. `workers-ai`: real models; locally
# scripts/dev.sh and devenv then start the services worker with
# `--env workers-ai` (remote AI binding, needs the Cloudflare token above).
LLM_BACKEND=mock

# Model addresses, `<provider>:<model>` (`anthropic:claude-sonnet-5`,
# `azure-responses:<deployment>`); a bare model ID is Workers AI.
AI_CLASSIFIER_MODEL=@cf/cloudflare/clef
AI_AGENT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# The values above are the defaults. The operator picks the model of each AI task
# (provider + model) on the Muhaha page; a provider is available there once the
# services worker has its key (deployments: Worker secrets; locally: .dev.vars via
# `xtask dev-vars`). All optional. Azure OpenAI (`azure`, `azure-responses`) needs both
# AZURE_* values; the Workers address the resource by name, the evals also take
# AZURE_OPENAI_ENDPOINT instead. `xtask eval --agent-model <provider>:<model>` uses them too.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESOURCE=

# --- Limits (defaults; per-org settings override thresholds) -------------------

DEFAULT_ESCALATION_THRESHOLD=0.70
DEFAULT_REPLY_CONFIDENCE_THRESHOLD=0.80
# Support messages accepted per org and hour, mail-in and the web form together.
MAX_INBOUND_PER_HOUR=100
# Orders an org may create per hour through checkout and scenario presets (web worker). Every
# mutating /api route also has a per-user burst limit: the MUTATION_LIMITER binding in
# apps/web-worker/wrangler.toml (60 per minute).
MAX_ORDERS_PER_HOUR=50
LLM_DAILY_TOKEN_BUDGET_PER_ORG=200000
LLM_DAILY_TOKEN_BUDGET_GLOBAL=5000000
# Days after provisioning that a demo org and all its data are deleted (services worker).
# Empty or 0: never (local default). Fractions work for trying it out (0.001 is ~86 s).
ORG_EXPIRY_DAYS=
