# Values for `scripts/deploy.sh --env <dev|live>` run from a shell (docs/deploy.md). Copy to
# deploy/dev.env or deploy/live.env (git-ignored); the environment wins over the file. The
# GitHub Deploy workflow gets the same keys from the GitHub environment `dev` or `live` instead.

# --- Cloudflare (one account for both environments) ----------------------------
CLOUDFLARE_ACCOUNT_ID=
# Workers Scripts:Edit, D1:Edit, Workers AI:Read (+ Zone DNS:Edit on techdepo.dev for live's
# custom domain).
CLOUDFLARE_API_TOKEN=
# `wrangler d1 create techdepo-dev` / `techdepo-live`.
D1_DATABASE_ID=

# --- Restate Cloud (one environment per deployment) ------------------------------
# https://<environment>.env.<region>.restate.cloud:8080
RESTATE_INGRESS_URL=
# https://<environment>.env.<region>.restate.cloud:9070
RESTATE_ADMIN_URL=
# API key with admin access (deployment registration).
RESTATE_ADMIN_TOKEN=

# --- Clerk (dev: development instance, live: production instance) ----------------
CLERK_PUBLISHABLE_KEY=
# Optional; default the environment's shop URL.
CLERK_AUTHORIZED_PARTIES=

# --- Secrets, uploaded with --secrets (or `wrangler secret put … --env <env>`) -----
RESTATE_IDENTITY_KEYS=
RESTATE_API_KEY=
RESEND_API_KEY=
CLERK_SECRET_KEY=
# Optional model provider keys (services worker): each makes its provider selectable for
# every AI task on the Muhaha page (Azure OpenAI: both AZURE_* values, the resource by name).
# Empty: the provider stays unavailable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESOURCE=

# --- Default models (optional; empty: wrangler.toml and code defaults) --------------
# The defaults until the operator saves model settings on the Muhaha page (stored in D1, so
# they survive deploys and override these per task).
# `workers-ai` or `mock`.
LLM_BACKEND=
# Model addresses, `<provider>:<model>` (`anthropic:claude-sonnet-5`); a bare ID is Workers AI.
AI_AGENT_MODEL=
AI_CLASSIFIER_MODEL=
# `on` (default) / `off`: JSON-mode classification on the agent model when Clef fails.
AI_FALLBACK_CLASSIFIER=
LLM_DAILY_TOKEN_BUDGET_PER_ORG=
LLM_DAILY_TOKEN_BUDGET_GLOBAL=
